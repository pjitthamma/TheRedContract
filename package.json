{
  "name": "the-red-contract",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "api:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "api:types": "wrangler types cloudflare/worker-configuration.d.ts --config cloudflare/wrangler.jsonc --include-runtime false",
    "api:check": "tsc -p cloudflare/tsconfig.json",
    "api:dry-run": "wrangler deploy --config cloudflare/wrangler.jsonc --dry-run",
    "db:local": "wrangler d1 migrations apply the-red-contract --local --config cloudflare/wrangler.jsonc",
    "db:seed:local": "node scripts/seed-local.mjs",
    "db:export": "node scripts/export-supabase.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20260925.0-alpha",
    "typescript": "^5.8.0",
    "vite": "^7.3.6",
    "wrangler": "^4.141.0"
  }
}
